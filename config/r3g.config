CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-3g=y

# MT7621闭源无线驱动
CONFIG_PACKAGE_mt76=y
CONFIG_PACKAGE_hostapd=y
CONFIG_PACKAGE_wpad=y
CONFIG_PACKAGE_mt76_OPENWRT=n
CONFIG_PACKAGE_kmod-mt76=n
CONFIG_MT76_CLOSED_SOURCE=y
CONFIG_MT7621_FIRMWARE=y

# 基础系统+Argon主题
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-theme-argon=y

# U盘、移动硬盘USB存储驱动
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs=y
CONFIG_PACKAGE_ntfs-3g=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y

# 4G随身WiFi上网卡驱动（RNDIS/QMI/MBIM）
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-mbim=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_mbim-utils=y

# 需要的插件
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-ddnsto=y
